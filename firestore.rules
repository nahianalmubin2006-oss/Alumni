rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return (
        (isSignedIn() && (
          request.auth.token.email == 'nahianalmubin2006@gmail.com' ||
          request.auth.token.email == 'nahianalmubin212528@gmail.com' ||
          request.auth.token.email == 'nahianalmubin2@gmail.com'
        )) ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUniversityAdmin(uni) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'UNIVERSITY_ADMIN' &&
        getUserData().assignedUniversity == uni
      );
    }

    function isDepartmentAdmin(uni, dept) {
      return isSuperAdmin() || isUniversityAdmin(uni) || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'DEPARTMENT_ADMIN' &&
        getUserData().assignedUniversity == uni &&
        getUserData().assignedDepartment == dept
      );
    }

    // Test Connection Check
    match /test/{testId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSuperAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isSuperAdmin();
    }

    // Universities Collection (Public Directory, Admin Managed)
    match /universities/{universityId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Departments Collection (Public Directory, Admin Managed)
    match /departments/{departmentId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && isUniversityAdmin(request.resource.data.university));
      allow update, delete: if isSuperAdmin() || (isSignedIn() && isUniversityAdmin(resource.data.university));
    }

    // Batches Collection (Public Directory)
    match /batches/{batchId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || (isSignedIn() && (getUserData().role == 'UNIVERSITY_ADMIN' || getUserData().role == 'DEPARTMENT_ADMIN'));
      allow delete: if isSuperAdmin();
    }

    // Alumni Collection (Public Directory)
    match /alumni/{alumniId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        getUserData().role == 'UNIVERSITY_ADMIN' ||
        getUserData().role == 'DEPARTMENT_ADMIN'
      ));
      allow delete: if isSuperAdmin();
    }

    // Students Collection (Public Directory)
    match /students/{studentId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isSignedIn() || (request.resource.data.status == 'PENDING');
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        getUserData().role == 'UNIVERSITY_ADMIN' ||
        getUserData().role == 'DEPARTMENT_ADMIN'
      ));
      allow delete: if isSuperAdmin();
    }

    // Live News Collection (Public Directory)
    match /news/{newsId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.authorId == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        getUserData().role == 'UNIVERSITY_ADMIN' ||
        getUserData().role == 'DEPARTMENT_ADMIN'
      ));
      allow delete: if isSuperAdmin() || (isSignedIn() && (
        getUserData().role == 'UNIVERSITY_ADMIN' ||
        getUserData().role == 'DEPARTMENT_ADMIN'
      )) || (resource.data.isPermanent == false);
    }

    // Change Requests Collection
    match /changeRequests/{requestId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Verification Requests Collection
    match /verificationRequests/{verificationId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.recipientId == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // Admin Assignments Collection
    match /adminAssignments/{assignmentId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isSuperAdmin();
    }

    // Platform Settings Collection
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // User Posts & Community Reactions
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
