rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny every operation unless a collection below explicitly permits it.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A profile's role field is not proof of Super Admin authority.
    // Only allowlisted, email-verified Firebase identities are platform Super Admins.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'nahianalmubin2006@gmail.com',
          'nahianalmubin212528@gmail.com',
          'nahianalmubin2@gmail.com'
        ];
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUniversityAdmin(uni) {
      return isSuperAdmin() || (
        hasUserProfile()
        && request.auth.token.email_verified == true
        && getUserData().role == 'UNIVERSITY_ADMIN'
        && getUserData().assignedUniversity == uni
      );
    }

    function isDepartmentAdmin(uni, dept) {
      return isSuperAdmin() || isUniversityAdmin(uni) || (
        hasUserProfile()
        && request.auth.token.email_verified == true
        && getUserData().role == 'DEPARTMENT_ADMIN'
        && getUserData().assignedUniversity == uni
        && getUserData().assignedDepartment == dept
      );
    }

    function canManageDirectory(uni, dept) {
      return isSuperAdmin() || isUniversityAdmin(uni) || isDepartmentAdmin(uni, dept);
    }

    function userProfileFields() {
      return [
        'id', 'uid', 'email', 'name', 'role', 'status', 'profileType',
        'university', 'department', 'studentId', 'educationLevel',
        'studentYear', 'expectedGraduation', 'graduationYear', 'jobRole',
        'company', 'country', 'city', 'bio', 'photoUrl', 'linkedin',
        'isVerifiedAlumni', 'assignedUniversity', 'assignedDepartment',
        'followedUniversities', 'savedUniversities', 'createdAt', 'updatedAt'
      ];
    }

    function editableProfileFields() {
      return [
        'name', 'university', 'department', 'studentId', 'educationLevel',
        'studentYear', 'expectedGraduation', 'graduationYear', 'jobRole',
        'company', 'country', 'city', 'bio', 'photoUrl', 'linkedin',
        'followedUniversities', 'savedUniversities', 'updatedAt'
      ];
    }

    function ownerCanEditProfile() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(editableProfileFields())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.profileType == resource.data.profileType
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /test/{testId} {
      allow read: if true;
    }

    // User roles and approval status are controlled by Super Admins only.
    match /users/{userId} {
      allow read: if isSuperAdmin() || isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userProfileFields())
        && request.resource.data.keys().hasAll([
          'id', 'uid', 'email', 'name', 'role', 'status', 'profileType',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && (
          (
            isSuperAdmin()
            && request.resource.data.role == 'SUPER_ADMIN'
            && request.resource.data.status == 'APPROVED'
            && request.resource.data.profileType == 'Admin'
          )
          || (
            !isSuperAdmin()
            && request.resource.data.status == 'PENDING'
            && (
              (request.resource.data.role == 'STUDENT' && request.resource.data.profileType == 'Student')
              || (request.resource.data.role == 'ALUMNI' && request.resource.data.profileType == 'Alumni')
            )
            && request.resource.data.get('isVerifiedAlumni', false) == false
            && request.resource.data.get('assignedUniversity', '') == ''
            && request.resource.data.get('assignedDepartment', '') == ''
          )
        );
      allow update: if request.resource.data.uid == resource.data.uid
        && request.resource.data.id == resource.data.id
        && (isSuperAdmin() || (isOwner(userId) && ownerCanEditProfile()));
      allow delete: if isSuperAdmin();
    }

    // Public directory reads; writes are limited to the responsible admins.
    match /universities/{universityId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isUniversityAdmin(resource.data.name)
        && request.resource.data.name == resource.data.name
      );
      allow delete: if isSuperAdmin();
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isUniversityAdmin(request.resource.data.university);
      allow update: if isSuperAdmin() || (
        request.resource.data.university == resource.data.university
        && request.resource.data.name == resource.data.name
        && (
          isUniversityAdmin(resource.data.university)
          || isDepartmentAdmin(resource.data.university, resource.data.name)
        )
      );
      allow delete: if isSuperAdmin()
        || isUniversityAdmin(resource.data.university)
        || isDepartmentAdmin(resource.data.university, resource.data.name);
    }

    match /batches/{batchId} {
      allow read: if true;
      allow create: if canManageDirectory(
        request.resource.data.university,
        request.resource.data.department
      );
      allow update: if canManageDirectory(
        resource.data.university,
        resource.data.department
      ) && canManageDirectory(
        request.resource.data.university,
        request.resource.data.department
      ) && request.resource.data.university == resource.data.university;
      allow delete: if isSuperAdmin();
    }

    match /alumni/{alumniId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        isOwner(request.resource.data.userId)
        && alumniId == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'name', 'email', 'university', 'department', 'batch',
          'studentId', 'educationLevel', 'graduationYear', 'jobRole', 'company',
          'country', 'city', 'bio', 'photoUrl', 'linkedin', 'isVerified',
          'status', 'createdAt', 'updatedAt'
        ])
      );
      allow update: if isSuperAdmin()
        || (
          isUniversityAdmin(resource.data.university)
          && request.resource.data.university == resource.data.university
        )
        || (
          isDepartmentAdmin(resource.data.university, resource.data.department)
          && request.resource.data.university == resource.data.university
          && request.resource.data.department == resource.data.department
        )
        || (
          isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'university', 'department', 'batch', 'studentId',
            'educationLevel', 'graduationYear', 'jobRole', 'company', 'photoUrl',
            'country', 'city', 'bio', 'linkedin', 'updatedAt'
          ])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
          && request.resource.data.isVerified == resource.data.isVerified
        );
      allow delete: if isSuperAdmin();
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        isOwner(request.resource.data.userId)
        && studentId == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'name', 'email', 'university', 'department', 'studentId',
          'educationLevel', 'studentYear', 'expectedGraduation', 'bio', 'photoUrl',
          'status', 'createdAt', 'updatedAt'
        ])
      );
      allow update: if isSuperAdmin()
        || (
          isUniversityAdmin(resource.data.university)
          && request.resource.data.university == resource.data.university
        )
        || (
          isDepartmentAdmin(resource.data.university, resource.data.department)
          && request.resource.data.university == resource.data.university
          && request.resource.data.department == resource.data.department
        )
        || (
          isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'university', 'department', 'studentId', 'educationLevel',
            'studentYear', 'expectedGraduation', 'bio', 'photoUrl', 'updatedAt'
          ])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
        );
      allow delete: if isSuperAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (
        isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && (
          (
            request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
            && request.resource.data.get('isPermanent', false) == false
          )
          || isUniversityAdmin(request.resource.data.university)
          || isDepartmentAdmin(request.resource.data.university, request.resource.data.department)
        )
      );
      allow update: if isSuperAdmin()
        || (
          isUniversityAdmin(resource.data.university)
          && request.resource.data.university == resource.data.university
        )
        || (
          isDepartmentAdmin(resource.data.university, resource.data.department)
          && request.resource.data.university == resource.data.university
          && request.resource.data.department == resource.data.department
        )
        || (
          isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'summary', 'content', 'imageUrl', 'sourceUrl', 'updatedAt'
          ])
          && request.resource.data.status == resource.data.status
          && request.resource.data.isPermanent == resource.data.isPermanent
        );
      allow delete: if isSuperAdmin()
        || isUniversityAdmin(resource.data.university)
        || isDepartmentAdmin(resource.data.university, resource.data.department)
        || (
          isSignedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.isPermanent != true
        );
    }

    match /changeRequests/{requestId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn()
        && hasUserProfile()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'requesterName', 'requesterEmail', 'requesterRole',
          'targetType', 'targetId', 'targetTitle', 'university', 'department',
          'oldValue', 'newValue', 'reason', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'requesterId', 'requesterName', 'requesterEmail', 'requesterRole',
          'targetType', 'targetTitle', 'oldValue', 'newValue', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.requesterRole == getUserData().role
        && request.resource.data.targetType in ['UNIVERSITY', 'DEPARTMENT', 'NEWS', 'BATCH', 'SETTINGS']
        && request.resource.data.status == 'PENDING'
        && request.resource.data.targetTitle is string
        && request.resource.data.targetTitle.size() <= 240
        && request.resource.data.oldValue is string
        && request.resource.data.oldValue.size() <= 5000
        && request.resource.data.newValue is string
        && request.resource.data.newValue.size() <= 5000
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() <= 1000;
      // Requesters cannot approve, reject, or rewrite an existing request.
      allow update, delete: if isSuperAdmin();
    }

    match /verificationRequests/{verificationId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'university', 'department',
          'batch', 'studentId', 'proofUrl', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'userName', 'userEmail', 'university', 'department',
          'batch', 'proofUrl', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && request.resource.data.proofUrl is string
        && request.resource.data.proofUrl.matches('https://.*')
        && request.resource.data.proofUrl.size() <= 2000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000;
      allow update, delete: if isSuperAdmin();
    }

    // Profile claims can be submitted only by the authenticated claimant.
    // Only trusted Super Admins may review them; requesters cannot self-approve.
    match /profileClaims/{claimId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'requesterName', 'requesterEmail', 'targetAlumniId',
          'university', 'department', 'studentId', 'graduationYear',
          'proofUrl', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'requesterId', 'requesterName', 'requesterEmail', 'targetAlumniId',
          'university', 'department', 'studentId', 'graduationYear',
          'proofUrl', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && request.resource.data.targetAlumniId is string
        && request.resource.data.targetAlumniId.size() > 0
        && request.resource.data.proofUrl is string
        && request.resource.data.proofUrl.matches('https://.*')
        && request.resource.data.proofUrl.size() <= 2000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && exists(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId))
        && get(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId)).data.get('userId', '') == ''
        && (
          get(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId)).data.get('email', '') == request.auth.token.email
          || (
            request.resource.data.studentId is string
            && request.resource.data.studentId.size() > 0
            && get(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId)).data.get('studentId', '') == request.resource.data.studentId
          )
        )
        && request.resource.data.university == get(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId)).data.university
        && request.resource.data.department == get(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId)).data.department
        && request.resource.data.studentId == get(/databases/$(database)/documents/alumni/$(request.resource.data.targetAlumniId)).data.get('studentId', '');
      allow update: if isSuperAdmin()
        && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reviewedBy', 'reviewerComment'
        ])
        && request.resource.data.status in ['APPROVED', 'REJECTED'];
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.recipientId == request.auth.uid)
        || (isSignedIn() && resource.data.recipientId == 'ADMIN' && isSuperAdmin());
      allow create: if isSuperAdmin() || (
        isSignedIn()
        && request.resource.data.keys().hasOnly([
          'recipientId', 'recipientRole', 'title', 'message', 'type',
          'read', 'actionUrl', 'createdAt'
        ])
        && (
          request.resource.data.recipientId == request.auth.uid
          || request.resource.data.recipientId == 'ADMIN'
        )
      );
      allow update: if isSuperAdmin() || (
        isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.recipientId == request.auth.uid);
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      // Audit entries are privileged records; client-authored audit rows are not trusted.
      // Server-side administrative mutations write their audit trail separately.
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /adminAssignments/{assignmentId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isSuperAdmin();
    }

    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'authorName', 'authorEmail', 'authorRole',
          'authorUniversity', 'authorDepartment', 'authorPhotoUrl',
          'content', 'imageUrl', 'createdAt', 'reactions'
        ])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000;
      // Content edits are owner-only; reactions can be changed without granting edit rights.
      allow update: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'imageUrl', 'updatedAt'
          ])
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactions', 'updatedAt'
          ])
        );
      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
