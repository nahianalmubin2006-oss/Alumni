rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures are public profile assets. Only the signed-in owner may upload,
    // replace, or remove files inside their own UID folder.
    match /profile-photos/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other Storage paths unless a rule is added explicitly.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
